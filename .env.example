# Midnight Preprod. Copy to .env.local (gitignored) — sync-wallets writes seeds
# here on first run so the same addresses persist across restarts.
MIDNIGHT_NETWORK=preprod
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# 64-char hex. Generated on first `npm run sync-wallets` if absent.
# DEPLOYER deploys the anchor contract (shielded path, needs DUST).
# AGENT is the demo signer for Intents (unshielded).
MIDNIGHT_DEPLOYER_SEED=
MIDNIGHT_AGENT_SEED=
