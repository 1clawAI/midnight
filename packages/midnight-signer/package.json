{
  "name": "@1claw/midnight-signer",
  "version": "0.1.0",
  "description": "HTTP sidecar exposing Midnight unshielded signing to non-JS callers",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "midnight-signer": "./src/server.ts"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.1.2",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "@midnight-ntwrk/zswap": "^4.0.0",
    "@midnightntwrk/wallet-sdk": "^1.2.0",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "graphql-ws": "^6.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
